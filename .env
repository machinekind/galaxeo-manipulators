# Base image. Swap for a lighter one if you don't need Gazebo/RViz:
#   osrf/ros:humble-desktop-full  ~ RViz2 + Gazebo Classic + demos (default)
#   osrf/ros:humble-desktop       ~ RViz2, no Gazebo
#   ros:humble-ros-base           ~ headless, smallest
BASE_IMAGE=osrf/ros:humble-desktop-full

# Container user is created with these so files written into ros2_ws/ stay
# owned by you on the host.
CONTAINER_USER=ros
USER_UID=1000
USER_GID=1000

# ROS 2 runtime settings
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Host group IDs passed through for device access (/dev/ttyUSB*, /dev/video*, /dev/dri).
DIALOUT_GID=20
VIDEO_GID=44
RENDER_GID=992
